GROUP3_TARGET_PAPERS=8
GROUP3_MINIMUM_PAPERS=7
GROUP3_CANDIDATE_MULTIPLIER=3
GROUP3_DOWNLOAD_DELAY_SECONDS=15
GROUP3_API_DELAY_SECONDS=3
GROUP3_SEARCH_PROVIDER=auto
GROUP3_MAX_SEARCH_ROUNDS=3
GROUP3_RETRIEVAL_PLANNER_MODE=auto
GROUP3_STORE_ROOT=data/papers
GROUP3_GROBID_URL=http://localhost:8070
GROUP3_PREFERRED_FORMAT=html
# Writer groq mode only; never commit actual keys.
GROQ_API_KEY=
GROUP3_WRITER_MODE=extractive
GROUP3_GROQ_MODEL=openai/gpt-oss-20b
GROUP3_GROQ_TIMEOUT_SECONDS=90
GROUP3_OUTPUT_ROOT=data/reports
GROUP3_TASK_TIMEOUT_SECONDS=600
# Optional endpoints proposed for team integration; protocols remain unagreed.
# GROUP3_SUPERVISOR_URL=http://127.0.0.1:9000/
# GROUP3_READER_URL=http://127.0.0.1:9001/
# GROUP3_CONNECTIONS_URL=http://127.0.0.1:9003/
