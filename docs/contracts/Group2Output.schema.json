{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "connection_id": {
          "title": "Connection Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "similarity",
            "difference",
            "conflict"
          ],
          "title": "Kind",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "connection_id",
        "kind",
        "claims"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "paper_id",
        "section_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReaderResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "overview": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Overview",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Methods",
          "type": "array"
        },
        "datasets": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Datasets",
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Results",
          "type": "array"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "paper_id"
      ],
      "title": "ReaderResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exchange envelope proposed for Group 2; not a finalized team contract.",
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "title": "Task Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "title": "Run Id",
      "type": "string"
    },
    "paper_ids": {
      "items": {
        "type": "string"
      },
      "title": "Paper Ids",
      "type": "array"
    },
    "reader_results": {
      "items": {
        "$ref": "#/$defs/ReaderResult"
      },
      "title": "Reader Results",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/Connection"
      },
      "title": "Connections",
      "type": "array"
    },
    "research_gaps": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Research Gaps",
      "type": "array"
    },
    "data_provenance": {
      "default": "group2",
      "enum": [
        "group2",
        "example_fixture"
      ],
      "title": "Data Provenance",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "run_id"
  ],
  "title": "Group2Output",
  "type": "object",
  "$comment": "Provisional Group 3 contract v0.1; requires agreement with Groups 1 and 2."
}
